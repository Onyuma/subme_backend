  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "lib": ["dom", "es2020"],
    "target": "es6",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true
  },
  "exclude": ["node_modules"],
  "include": ["src"]
}
